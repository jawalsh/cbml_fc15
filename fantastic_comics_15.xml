        <group>
            <text xml:id="fantastic_comics_15_samson_and_david">
                <body>
                    <pb n="3" facs="#pg_03"/>
                    <div type="panelGrp">
                        <cbml:panel facs="#pg_03_pnl_01">
                            <head><title rendition="#uc">Samson and David</title></head>
                            <cbml:caption rendition="#uc">Out of the mists of history comes mighty
                                Samson--Like his famous ancestor, Samson pits his tremendous
                                strength against the forces of evil and injustice--Mu… high priest
                                of evil, plots agains civilization… </cbml:caption>
                            <byline rendition="#uc">By—<lb/><hi rend="#b">Alex Boon</hi></byline>
                        </cbml:panel>
                        <cbml:panel facs="#pg_03_pnl_02">
                            <cbml:balloon who="#david" type="speech" rendition="#uc">What a funny
                                looking truck outside here… Never saw one like it
                                before!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">That's
                                strange! What’s it look like?</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_03_pnl_03">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">You’re
                                right--I never saw one like this before!</cbml:balloon>
                            <cbml:balloon type="thought" who="#david" rendition="#uc">Wonder what
                                it’s doing here?</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_03_pnl_04">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">What
                                the--!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david" rendition="#uc">Gas--<emph
                                    rendition="#b">help!</emph></cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_03_pnl_05">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">No time to
                                look for doors now!</cbml:balloon>
                            <sound rendition="#uc">Crash!</sound>
                            <fw place="right" type="pageNum">1</fw>
                        </cbml:panel>
                    </div>
                    <pb n="4" facs="#pg_04"/>
                    <div type="panelGrp">
                        <cbml:panel facs="#pg_04_pnl_01">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">That gas is
                                sinking--I’d better get David up on the roof here!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david" rendition="#uc"
                                >Oh!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_02">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">And then I’ll
                                look for those rats!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_03">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">You all right
                                David?</cbml:balloon>
                            <cbml:balloon type="speech" who="#david" rendition="#uc">I will be in a
                                minute… That’s some gas!</cbml:balloon>

                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_04">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">Stay here and
                                get your breath, David--I’ll be back!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david" rendition="#uc">I’ll wait for
                                you!</cbml:balloon>

                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_05">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">First I might
                                as well tend to this item!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_06">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">I’ll just toss
                                it where it can't do any harm!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_07">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">—And you boys
                                cantel me who is responsible for that trick!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_04_pnl_08">
                            <cbml:balloon type="speech" who="#samson" rendition="#uc">You’re rotten
                                shots--You haven’t a chance!</cbml:balloon>
                            <sound>Zing</sound>
                            <sound>Zing</sound>
                            <sound>Screech</sound>
                            <fw place="right" type="pageNum">2</fw>
                        </cbml:panel>
                    </div>
                    <pb n="5" facs="#pg_05"/>
                    <div type="panelGrp">
                        <cbml:panel facs="#pg_05_pnl_01">
                            <cbml:balloon type="speech" who="#anon" rendition="#uc">Help …
                                help!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">See how you like this
                                treatment!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon">Ow!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_02">
                            <cbml:balloon type="speech" who="#samson">But look out for the
                                bumps!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon">Oof!</cbml:balloon>
                            <sound>Crash!</sound>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_03">
                            <cbml:balloon type="speech" who="#samson">I’ll just let that fellow get
                                away and see where he goes!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_04">
                            <cbml:balloon type="speech" who="#samson">So there’s where they hang
                                out!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_05">
                            <cbml:balloon type="speech" who="#samson">First I’ll see how David is
                                getting along--</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_06">
                            <cbml:balloon type="speech" who="#samson"> Come on… Jump--I’ll catch
                                you! </cbml:balloon>
                            <cbml:balloon type="speech" who="#david"> I hope so! </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_07">
                            <cbml:balloon type="speech" who="#samson"> See? I said I’d catch you! </cbml:balloon>
                            <cbml:balloon type="speech" who="#david">
                                <emph rendition="#b">Ugh!</emph> So you did! </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_05_pnl_08">
                            <cbml:balloon type="speech" who="#david">
                                <emph rendition="#b">Good!!</emph>
                            </cbml:balloon>
                            <cbml:balloon type="speech" who="#samson"> Come on--We’ve got a little
                                job to do down by the waterfront! </cbml:balloon>
                            <fw place="right" type="pageNum">3</fw>
                        </cbml:panel>
                    </div>
                    <pb n="6" facs="#pg_06"/>
                    <div type="pnlGrp">
                        <cbml:panel facs="#pg_06_pnl_01">
                            <cbml:balloon type="speech" who="#samson"> It looks as though we’re not
                                welcome! </cbml:balloon>
                            <cbml:balloon type="speech" who="#david"> Try and sneak under it!
                            </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_02">
                            <cbml:balloon type="speech" who="#samson"> They certainly closed the
                                door fast </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_03">
                            <cbml:balloon type="speech" who="#samson"> That’s no obstacle for me-- </cbml:balloon>
                            <cbml:balloon type="speech" who="#david"> Let’s fo in! </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_04">
                            <cbml:balloon type="speech" who="#samson"> The place looks deserted now! </cbml:balloon>
                            <cbml:balloon type="speech" who="#david"> The rats have run back into
                                their holes! </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_05">
                            <cbml:balloon type="speech" who="#david">
                                <emph>Look out!</emph> YOu are getting careless! </cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">
                                <emph>Oops!</emph> What’s this? </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_06">
                            <cbml:balloon type="speech" who="#david"> Glad I didn’t go first! </cbml:balloon>
                            <cbml:balloon type="speech" who="#samson"> Quite a little trick--It
                                would have torn most people in half! </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_07">
                            <cbml:balloon type="speech" who="#david"> Well… What’s this? </cbml:balloon>
                            <cbml:balloon type="speech" who="#samson"> Looks like some sort of
                                secret factory </cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_08">
                            <cbml:balloon type="speech" who="#david">
                                <emph rendition="#bold">What?</emph> Look… This place is right over
                                the river! </cbml:balloon>
                            <cbml:balloon type="speech" who="#samson"> These machines are made to
                                stamp out the coins of every nation in the world! </cbml:balloon>
                        </cbml:panel>
                    </div>
                    <pb n="7" facs="#pg_07"/>
                    <div type="pnlGrp">
                        <cbml:panel facs="#pg_07_pnl_01">
                            <cbml:balloon type="speech" who="#samson">That’s handy--Just stand aside
                                there!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">Oh… Oh!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_06_pnl_02">
                            <cbml:balloon type="speech" who="#samson">No one has any business using
                                this sort of thing!</cbml:balloon>
                            <sound>Crash!</sound>
                            <cbml:balloon type="speech" who="#david">Well, they won’t
                                again!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_07_pnl_03">
                            <cbml:balloon type="speech" who="#david">You go ahead and play--I’ll
                                look around!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Go ahead… Holler if you want
                                me!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_07_pnl_04">
                            <cbml:balloon type="speech" who="#samson">Oh-oh… Do I hear
                                something?</cbml:balloon>
                            <sound>Crash!</sound>
                            <cbml:balloon type="speech" who="#david">Help! Help!!</cbml:balloon>
                            <!-- Do we identify speaker when we don't “know” speaker until a subsequent panel? -->
                        </cbml:panel>
                        <cbml:panel facs="#pg_07_pnl_05">
                            <cbml:balloon type="speech" who="#david">Samson-- <emph rendition="#b"
                                    >Help!!</emph></cbml:balloon>
                            <cbml:balloon type="thought" who="#samson">Sounds like David… Wonder
                                what he’s got into?</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_07_pnl_06">
                            <cbml:balloon type="speech" who="#samson">It comes from up there… I’d
                                better look into it!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_07_pnl_07">
                            <cbml:balloon type="speech" who="#samson">This is the quickest way to
                                get upstairs!</cbml:balloon>
                            <sound>Crash!!</sound>
                        </cbml:panel>
                        <cbml:panel facs="#pg_07_pnl_08">
                            <cbml:balloon type="speech" who="#david">Hurry-- It’s coming
                                down!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">I might have known you’d get
                                into something!</cbml:balloon>
                            <fw place="right" type="pageNum">5</fw>
                        </cbml:panel>
                    </div>
                    <pb n="8" facs="#pg_08"/>
                    <div type="pnlGrp">
                        <cbml:panel facs="#pg_08_pnl_01">
                            <cbml:balloon type="speech" who="#david">Is that soe?</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">You do pick the darndest
                                places to take a nap!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_08_pnl_02">
                            <cbml:balloon type="speech" who="#david">I am myself!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Now I’m beginning to get tired
                                of these games!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_08_pnl_03">
                            <cbml:balloon type="speech" who="#samson">There’s going to be a change
                                in this waterfront beginning now!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">What do you
                                mean?</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_08_pnl_04">
                            <cbml:balloon type="speech" who="#david">Yes… Where are you going to put
                                it?</cbml:balloon>
                            <cbml:balloon type="speech" who="#samons">Did you say this was right
                                over the river?</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_08_pnl_05">
                            <sound>Splash!</sound>
                            <cbml:balloon type="speech" who="#david">Whee!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">There she goes!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_08_pnl_06">
                            <cbml:balloon type="speech" who="#david">A man is trying to swim
                                away--the current is too strong for him!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Might be a good idea to fish
                                him out!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_08_pnl_07">
                            <cbml:balloon type="speech" who="#david">I’m right with
                                you!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Quick… To the bridge--get your
                                lariat ready!</cbml:balloon>
                            <fw place="right" type="pageNum">6</fw>
                        </cbml:panel>
                    </div>
                    <pb n="9" facs="#pg_09"/>
                    <div type="pnlGrp">
                        <cbml:panel facs="#pg_09_pnl_01">
                            <cbml:balloon type="speech" who="#samson">Don’t let him get by you,
                                David!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">I’ve almost got him
                                now!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon_man">Help!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_02">
                            <cbml:balloon type="speech" who="#anon_man"><emph rendition="#b">Save
                                    me!</emph> Don’t- Don’t let me go!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Hold tight!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">I’ve got him!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_03">
                            <cbml:balloon type="speech" who="#anon_man">I’m hanging on all
                                right!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Don’t let go of our friend
                                there!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">We’re here!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_04">
                            <cbml:balloon type="speech" who="#anon_man">You saved my life--I must
                                warn you now!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">Just tell us who’s making all
                                this trouble!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Of what?</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_05">
                            <cbml:balloon type="speech" who="#anon_man">It is Arpor, High Priest of
                                Evil… who is behind this… He has sworn to get you! </cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">High Priest of Evil? Sounds
                                daffy!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_06">
                            <cbml:balloon type="speech" who="#anon_man">Yes… He and his devotees are
                                mad… But very dangerous…</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">I believe you!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">Duck, everybody--We’re being
                                bombed!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_07">
                            <cbml:balloon type="speech" who="#david"><emph rendition="#b">Look out,
                                    Samson!</emph></cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">I think I can fix
                                that!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_09_pnl_08">
                            <cbml:balloon type="speech" who="#samson">And <choice>
                                    <sic>thats</sic>
                                    <corr>that’s</corr>
                                </choice> the end of you!</cbml:balloon>
                            <sound>Crash!</sound>
                            <cbml:balloon type="speech" who="#david">What a shot!</cbml:balloon>
                            <fw place="right" type="pageNum">7</fw>
                        </cbml:panel>
                    </div>
                    <pb n="10" facs="#pg_10"/>
                    <div type="panelGrp">
                        <cbml:panel facs="#pg_10_pnl_01">
                            <cbml:balloon type="speech" who="#david">Oooh!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon">I’ll do as you
                                say!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Thank you! Renounce Arbor and
                                his crazy worship… I’ll protect you!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_02">
                            <cbml:balloon type="speech" who="#samson">Now I’m going into the
                                mountains after Arpor!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">Oh… I want to
                                go!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_03">
                            <cbml:balloon type="speech" who="#samson">I know I shouldn’t take you,
                                but you’d come along somehow, anyway!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">That’s right!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_04">
                            <cbml:balloon type="speech" who="#david">Whew--Is this supposed to be a
                                path?</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">Arpor’s just making it hard
                                for his visitors!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_05">
                            <cbml:balloon type="speech" who="#david">Oh-oh!
                                Artillery!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">So it is… Don’t let it bother
                                you!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_06">
                            <cbml:balloon type="speech" who="#samson">Better change your elevation,
                                boys!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">Nice jumping,
                                there!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_07">
                            <cbml:balloon type="speech" who="#samson">I’ll borrow this for a
                                minute!</cbml:balloon>
                            <cbml:balloon type="speech" who="#david">Oh, boy!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon">Oooo!</cbml:balloon>
                        </cbml:panel>
                        <cbml:panel facs="#pg_10_pnl_08">
                            <cbml:balloon type="speech" who="#david">Look at ’em run!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon">Run!</cbml:balloon>
                            <cbml:balloon type="speech" who="#anon">What a demon!</cbml:balloon>
                            <cbml:balloon type="speech" who="#samson">You can try and put these
                                together after!</cbml:balloon>
                            <sound>Crash!</sound>

                            <fw place="right" type="pageNum">8</fw>
                        </cbml:panel>
                    </div>


